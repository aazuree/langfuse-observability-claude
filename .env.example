# Langfuse Self-Hosted Configuration
# Copy to .env and run: ./setup.sh (generates secrets automatically)
# Or fill in manually — all CHANGEME values must be replaced.

# === Langfuse Core ===
# NEXTAUTH_URL must match how you REACH the dashboard, or login/redirects break.
#   Local mode (default): http://localhost:3100
#   LAN/Pi mode:          http://<host-LAN-IP>:3100   (e.g. http://192.168.1.50:3100)
NEXTAUTH_URL=http://localhost:3100
NEXTAUTH_SECRET=CHANGEME_64_char_hex
ENCRYPTION_KEY=CHANGEME_64_char_hex
SALT=CHANGEME_32_char_hex

# === Network Exposure ===
# Interface the dashboard (langfuse-web, port 3100) publishes on. This is the
# ONLY service exposed beyond localhost; the rest stay bound to 127.0.0.1.
#   Local mode (default): 127.0.0.1  — reachable only on this machine
#   LAN/Pi mode:          <host-LAN-IP>  — reachable by local-network devices
# When set to a LAN IP, also point NEXTAUTH_URL (above) at http://<that-IP>:3100.
# See REMOTE-DEPLOY.md for the full Pi-hole / remote-host migration.
LANGFUSE_WEB_BIND=127.0.0.1

# === PostgreSQL ===
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:CHANGEME@postgres:5432/postgres

# === ClickHouse ===
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME

# === Redis ===
REDIS_AUTH=CHANGEME

# === MinIO (S3-compatible storage) ===
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=CHANGEME
LANGFUSE_S3_MEDIA_UPLOAD_ACCESS_KEY_ID=minio
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=CHANGEME

# === Initial Setup (auto-creates org, project, and user on first boot) ===
LANGFUSE_INIT_ORG_ID=my-org
LANGFUSE_INIT_ORG_NAME=MyOrg
LANGFUSE_INIT_PROJECT_ID=claude-code
LANGFUSE_INIT_PROJECT_NAME=ClaudeCode
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=CHANGEME_generated_by_setup
LANGFUSE_INIT_PROJECT_SECRET_KEY=CHANGEME_generated_by_setup
LANGFUSE_INIT_USER_EMAIL=CHANGEME
LANGFUSE_INIT_USER_NAME=CHANGEME
LANGFUSE_INIT_USER_PASSWORD=CHANGEME_min_12_chars

# === Telemetry ===
# Langfuse's anonymous usage telemetry to langfuse.com. Off unless set to true.
TELEMETRY_ENABLED=false

# === Langfuse v4 data model ===
# `events_only` writes only the v4 events tables. langfuse-hook.py exports
# over OpenTelemetry (/api/public/otel/v1/traces), which works in every mode.
# A stack still on `legacy` must delete its traces before switching — see
# REMOTE-DEPLOY.md, "Langfuse v4".
LANGFUSE_MIGRATION_V4_WRITE_MODE=events_only
# These move together with the write mode: events_only requires `direct`
# (langfuse-worker refuses to start with dual_write), and the v4 read paths
# need the preview opt-in. legacy needs dual_write / false instead.
LANGFUSE_MIGRATION_V4_NATIVE_OTEL_BEHAVIOUR=direct
LANGFUSE_MIGRATION_V4_ALLOW_PREVIEW_OPT_IN=true
LANGFUSE_BACKGROUND_MIGRATION_V4_ENABLE_HISTORIC_BACKFILL=false
